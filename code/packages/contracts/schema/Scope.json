      "required": [
        "mode",
        "ids"
      ],
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "all"
            },
            {
              "type": "string",
              "const": "selected"
            }
          ]
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "image_types": {
      "type": "object",
      "required": [
        "mode",
        "ids"
      ],
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "all"
            },
            {
              "type": "string",
              "const": "selected"
            }
          ]
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "required": [
        "mode",
        "binding_ids"
      ],
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
