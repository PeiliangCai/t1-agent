# Copy to deploy/local/workbench.env (excluded from Docker context and Git).
# Keep the actual key in code/.env; this file contains public configuration only.
T1_MODEL_PROVIDER=agicto
T1_MODEL_BASE_URL=https://api.agicto.cn/v1
T1_MODEL_ID=gpt-6-luna
# Safe clone default. Operator explicitly enables after deployment verification.
T1_WORKBENCH_MODEL_ENABLED=false
T1_WORKBENCH_MAX_REQUESTS=80
T1_WORKBENCH_MAX_INPUT_TOKENS=2000000
T1_WORKBENCH_MAX_OUTPUT_TOKENS=120000
