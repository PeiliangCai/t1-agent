# Copy to a PRIVATE file outside the build context (e.g. deploy/local/compose.env).
# Compose has its own namespace; existing host .env model switches/keys are ignored.
T1_COMPOSE_PROJECT=t1-workbench
T1_IMAGE=t1-workbench:local
T1_WEB_PORT=30142
T1_DATA_VOLUME=t1-workbench-data
T1_DOCLING_MODELS=./.tools/pdf-parser/models

T1_DEPLOY_MODEL_ENABLED=false
T1_DEPLOY_MODEL_PROVIDER=agicto
T1_DEPLOY_MODEL_BASE_URL=https://api.agicto.cn/v1
T1_DEPLOY_MODEL_ID=gpt-6-luna
T1_DEPLOY_MODEL_API_KEY=
T1_DEPLOY_MAX_REQUESTS=80
T1_DEPLOY_MAX_INPUT_TOKENS=2000000
T1_DEPLOY_MAX_OUTPUT_TOKENS=120000
