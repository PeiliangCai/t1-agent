+    schema = json.loads((CODE/'packages/contracts/schema/FigureAssetCatalog.json').read_text())
+    import jsonschema
+    jsonschema.validate(catalog, schema)
+    (output/'catalog.json').write_text(json.dumps(catalog, ensure_ascii=False, indent=2)+'\n')
