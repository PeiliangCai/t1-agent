+                      'mechanically_checked': sum(f['verification']['status'] == 'mechanically_checked' for f in catalog['figures']),
+                      'whole_figure_checked': 0, 'remote_calls': 0, 'catalog': str(Path(args.output)/'catalog.json')}))
