+async function sourceSnapshot(runtime: string) {
+  const paths = (await Promise.all(['packages/agent/src', 'packages/contracts/src'].map(async folder =>
+    (await readdir(folder)).filter(name => name.endsWith('.ts')).map(name => folder + '/' + name)))).flat();
+  paths.push('scripts/run-s4-selection.ts', 'tests/extraction/fixtures/evidence-fixtures.ts', 'package.json', 'package-lock.json',
+    'config/pdf-parser.json', 'docs/acceptance/s4/selection-optimization/authorization.json', 'docs/acceptance/s4/selection-optimization/tool-evaluation.json');
+  const content = await Promise.all(paths.sort().map(async path => ({ path, bytes: await readFile(path) })));
+  const hashes = Object.fromEntries(content.map(s => [s.path, hash(s.bytes)])), digest = hash(JSON.stringify(hashes));
