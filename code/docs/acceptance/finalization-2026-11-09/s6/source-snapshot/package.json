{
  "name": "t1-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run check:web",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "smoke:pi": "tsx scripts/smoke-pi.ts",
    "dev:server": "tsx apps/server/src/main.ts",
    "dev:web": "node scripts/pi-web.mjs dev",
    "build:web": "node scripts/pi-web.mjs build",
    "start:web": "node scripts/pi-web.mjs start",
    "check:web": "node scripts/pi-web.mjs check",
    "verify:s1": "tsx scripts/accept-s1.ts",
    "test:evaluation": "tsx --test tests/evaluation/*.test.ts",
    "eval:quality": "tsx scripts/evaluate-quality.ts",
    "eval:export-contracts": "tsx scripts/export-evaluation-contracts.ts",
    "parser:contracts": "tsx scripts/export-parser-contracts.ts",
    "parse:pdf": ".venv/bin/python services/pdf-parser/cli.py parse",
    "parse:pdf:structured": ".venv/bin/python services/pdf-parser/structured-cli.py parse",
    "verify:s3:pi": "tsx scripts/verify-s3-pi.ts",
    "test:parser": "tsx --test tests/parser/*.test.ts",
    "test:parser:python": ".venv/bin/python -m unittest discover -s services/pdf-parser/tests -v",
    "test:extraction": "tsx --test tests/extraction/*.test.ts",
    "s4:contracts": "tsx scripts/export-s4-contracts.ts",
    "s4:compare": "tsx scripts/compare-extraction-methods.ts",
    "eval:prepare-sample": "tsx scripts/prepare-output-sample.ts",
    "eval:independent-corpus": "tsx scripts/independent-corpus.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "24.19.2"
  }
}
