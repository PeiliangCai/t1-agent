{
  "public_configuration": "deploy/local/workbench.env",
  "private_key_file": ".env",
  "private_key_bytes_unchanged": true,
  "model_enabled_in_prepared_file": true,
  "running_process_restarted": false,
  "source_and_real_container_verification_required_before_activation": true,
  "model": "gpt-6-luna",
  "provider": "agicto",
  "reasoning_effort": "medium",
  "per_run_limits": {
    "requests": 80,
    "input_tokens": 2000000,
    "output_tokens": 120000,
    "slot_seconds": 1800,
    "parallel_slots": 2
  },
  "new_provider_requests": 0
}
