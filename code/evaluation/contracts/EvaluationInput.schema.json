{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "fixture",
    "purpose",
    "rule_version",
    "rules_status",
    "gold_version",
    "scope",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "s2-evaluation-1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "fixture": {
      "type": "boolean"
    },
    "purpose": {
      "enum": [
        "fixture_verification",
        "development_measurement",
        "independent_acceptance"
      ]
    },
    "rule_version": {
      "type": "string",
      "const": "s2-scoring-draft-1"
    },
    "rules_status": {
      "enum": [
        "pending_confirmation",
        "approved"
      ]
    },
    "gold_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope": {
      "type": "object",
      "required": [
        "scope_version",
        "cancers",
        "image_types",
        "features",
        "catalog_version",
        "matching_policy_version"
      ],
      "properties": {
        "scope_version": {
          "type": "string",
          "const": "1"
        },
        "cancers": {
          "type": "object",
          "required": [
            "mode",
            "ids"
          ],
          "properties": {
            "mode": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "all"
                },
                {
                  "type": "string",
                  "const": "selected"
                }
              ]
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "image_types": {
          "type": "object",
          "required": [
            "mode",
            "ids"
          ],
          "properties": {
            "mode": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "all"
                },
                {
                  "type": "string",
                  "const": "selected"
                }
              ]
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "features": {
          "type": "object",
          "required": [
            "mode",
            "binding_ids"
          ],
          "properties": {
            "mode": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "all"
                },
                {
                  "type": "string",
                  "const": "selected"
                }
              ]
            },
            "binding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
