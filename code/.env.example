# T1 server configuration. Never commit real credentials.
# First-release configurable default (D02): compatible low-cost option, not a claim
# of medical superiority. Existing exact supplier alias policy and medium reasoning apply.
T1_MODEL_PROVIDER=agicto
T1_MODEL_BASE_URL=https://api.agicto.cn/v1
T1_MODEL_ID=gpt-6-luna
T1_MODEL_API_KEY=

# Safe default: uploading, retained evidence, review and export remain available;
# starting a new model extraction is disabled. Old S4 balances are not reused.
T1_WORKBENCH_MODEL_ENABLED=false

# These switches/limits are read from process.env. loadModelConfig also reads
# model credentials from .env, but `npm run dev:server` does not automatically
# import .env switches/limits into process.env. To apply this entire file use:
#   node --env-file=.env --import tsx apps/server/src/main.ts
# Or export the WORKBENCH variables in the service environment before starting.
# Keep fresh clones disabled until the operator configures credentials/limits.
# The deployed host may add public settings via a second private operator file:
#   node --env-file=.env --env-file=deploy/local/workbench.env --import tsx apps/server/src/main.ts
# That file need not duplicate the key stored in .env. Uploading alone never invokes a model.

# Per-new-run ceilings; the browser cannot choose or increase these values.
# Requests include bounded retries and the same-run document summary.
T1_WORKBENCH_MAX_REQUESTS=80
T1_WORKBENCH_MAX_INPUT_TOKENS=2000000
T1_WORKBENCH_MAX_OUTPUT_TOKENS=120000
# Server constants: two FIFO execution slots. A third run waits with its own
# persisted queued state and may be cancelled. Each slot gets 1800 s including
# PDF parsing, model batches and summary; queue waiting does not consume it.
# 120 s/request, at most 2 transient retries,
# at most 16 responses/batch. Each run creates its own new request ledger.
# When AGICTO gpt-6-luna is explicitly configured, both the ordinary runner and
# isolated verification reuse the pinned, user-relayed exact deployment alias
# gpt-6-luna <-> igpt-6-luna. No prefix wildcard or different model is accepted.

# Optional trusted server-only JSON EvidenceCatalogSchema file, loaded at startup.
# Unset => unavailable catalog; all three dimensions still default to all.
# Only genuinely approved non-fixture catalogs/entries/synonyms are accepted.
# No production vocabulary is supplied or approved by this application. Invalid
# configuration stops startup; changing catalog_version invalidates stale scopes.
# T1_WORKBENCH_CATALOG_FILE=/private/approved-evidence-catalog.json
